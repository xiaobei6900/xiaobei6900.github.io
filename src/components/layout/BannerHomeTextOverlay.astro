---
import { Icon } from "astro-icon/components";
import TypewriterText from "@/components/features/TypewriterText.astro";
import { backgroundWallpaper } from "@/config";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";

interface Props {
	showHomeText: boolean;
	initialRandomSubtitle: string | undefined;
}

const { showHomeText, initialRandomSubtitle } = Astro.props;
const homeText = backgroundWallpaper.common?.homeText;
const homeTextLinks = homeText?.links;
const homeTextLinksEnable = homeText?.linksEnable !== false;
---
{homeText?.enable && (
    <div class={`banner-home-text-overlay absolute inset-0 z-20 flex items-center justify-center ${!showHomeText ? 'hidden' : ''}`}>
        <div class="w-4/5 lg:w-3/4 text-center mb-0">
            <div class="flex flex-col">
                {homeText.title && (
                    <div class="banner-title font-bold text-white mb-2 lg:mb-4 leading-tight" style={{ '--banner-title-size': homeText.titleSize || "3rem" }}>
                        {homeText.title}
                    </div>
                )}
                {homeText.subtitle && (
                    <div id="banner-subtitle" class="banner-subtitle text-white/90 leading-snug" style={{ fontSize: homeText.subtitleSize || "1.5rem" }} data-subtitles={JSON.stringify(homeText.subtitle)}>
                        {homeText.typewriter?.enable ? (
                            <TypewriterText
                                text={homeText.subtitle}
                                speed={homeText.typewriter.speed}
                                deleteSpeed={homeText.typewriter.deleteSpeed}
                                pauseTime={homeText.typewriter.pauseTime}
                            />
                        ) : (
                            initialRandomSubtitle
                        )}
                    </div>
                )}
                {/* 横幅标题下方的链接图标（subtitle 的兄弟节点，避免被打字机/随机副标题的 textContent 覆盖清掉） */}
                {homeTextLinksEnable && homeTextLinks && homeTextLinks.length > 0 && (
                    <div class="banner-links mt-5 flex items-center justify-center gap-3 pointer-events-auto">
                        {homeTextLinks.map((link) => {
                            // mailto 链接做 base64 加密防爬虫（点击时才解码导航，与 Profile 一致）
                            const isMailto = link.url.startsWith("mailto:");
                            const encodedEmail = isMailto
                                ? encodeMailto(link.url)
                                : undefined;
                            const isExternal = link.url.startsWith("http");
                            return (
                                <a
                                    href={isMailto ? "#" : link.url}
                                    aria-label={link.name}
                                    title={link.name}
                                    data-encoded-email={encodedEmail}
                                    target={!isMailto && isExternal ? "_blank" : undefined}
                                    rel={!isMailto && isExternal ? "noopener" : undefined}
                                    class={link.showName ? "banner-link banner-link-text" : "banner-link"}
                                    style="color: #fff"
                                    onclick={isMailto ? MAILTO_ONCLICK_SCRIPT : undefined}
                                >
                                    {/* 内联 fill: currentColor，避免 CSS 加载前 SVG 默认黑色图标闪现 */}
                                    <Icon name={link.icon} class="text-[1.25rem]" style="fill: currentColor" />
                                    {link.showName && <span>{link.name}</span>}
                                </a>
                            );
                        })}
                    </div>
                )}
                {/* AI 维护声明：首页横幅首屏常驻，压在最下方一行 */}
                <div class="banner-ai-notice">
                    <span class="banner-ai-notice-badge">
                        <Icon name="material-symbols:robot-2-outline-rounded" class="banner-ai-notice-icon" style="fill: currentColor" />
                        <span>本博客内容完全由 AI 维护，仅作为个人笔记</span>
                    </span>
                </div>
            </div>
        </div>
    </div>
)}

<style>
    .banner-ai-notice {
        display: flex;
        justify-content: center;
        margin-top: 1.5rem;
        pointer-events: none;
    }

    .banner-ai-notice-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        max-width: 100%;
        padding: 0.5rem 1.125rem;
        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.38);
        color: #fff;
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.45;
        text-align: center;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
    }

    .banner-ai-notice-icon {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
    }

    @media (max-width: 767px) {
        .banner-ai-notice {
            margin-top: 1rem;
        }

        .banner-ai-notice-badge {
            gap: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.8125rem;
        }

        .banner-ai-notice-icon {
            width: 1rem;
            height: 1rem;
        }
    }
</style>

<script is:inline>
    function setRandomSubtitle() {
        const subtitleElement = document.getElementById('banner-subtitle');
        if (!subtitleElement) return;

        const subtitlesData = subtitleElement.dataset.subtitles;
        if (!subtitlesData) return;

        try {
            const subtitles = JSON.parse(subtitlesData);
            // Only randomize if it's an array and typewriter is NOT enabled (check for typewriter class)
            if (Array.isArray(subtitles) && subtitles.length > 0 && !subtitleElement.querySelector('.typewriter')) {
                // Use a global variable to persist the subtitle across Swup navigations
                // This variable will be reset on full page reload (F5), meeting the requirement
                if (!window.fireflyCachedSubtitle) {
                    const randomIndex = Math.floor(Math.random() * subtitles.length);
                    window.fireflyCachedSubtitle = subtitles[randomIndex];
                }
                subtitleElement.textContent = window.fireflyCachedSubtitle;
            }
        } catch (e) {
            console.error("Failed to parse subtitles", e);
        }
    }

    // Run on initial load
    setRandomSubtitle();
</script>
